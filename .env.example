# Malabar Sentinel — Environment Variables
# Copy this file to .env and fill in your values.
# The server loads it automatically via python-dotenv.

# ── Authentication ──────────────────────────────────────────────────────────
# REQUIRED: Change these before deploying to production!
# SOC_ADMIN_KEY is used by the dashboard. AGENT_KEY is used by endpoint agents.
# Keep them different and treat both as secrets.
SOC_ADMIN_KEY=change-me-admin-key
AGENT_KEY=change-me-agent-key

# Legacy alias (still accepted; SOC_ADMIN_KEY takes precedence)
# SOC_MASTER_KEY=change-me-admin-key

# ── CORS / Allowed Origins ──────────────────────────────────────────────────
# Comma-separated list of origins that may access the API.
# Defaults to localhost:9001 only if not set.
# Example for production: SOC_ALLOWED_ORIGINS=https://soc.example.com
SOC_ALLOWED_ORIGINS=http://localhost:9001,http://127.0.0.1:9001

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=soc_platform.db

# PostgreSQL (production):
# DATABASE_URL=postgresql://socuser:password@localhost:5432/socdb

# ── Server ───────────────────────────────────────────────────────────────────
SOC_HOST=0.0.0.0
SOC_PORT=9001
LOG_LEVEL=info

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Maximum requests per minute per IP address.
SOC_RATE_LIMIT_PER_MINUTE=300

# ── Scan Limits ───────────────────────────────────────────────────────────────
# Maximum file size (MB) to hash during agent scans. Files larger than this
# are skipped during hash checking to avoid stalling on huge archives.
SCAN_MAX_FILE_MB=64

# Extra directories to exclude from agent scans (comma-separated absolute paths).
# The agent always excludes its quarantine dir, system dirs, and cache folders.
# SCAN_EXCLUDED_DIRS=/mnt/backup,/opt/vendor

# ── File Encryption ───────────────────────────────────────────────────────────
# Key used for remote file encryption via SOC command.
SOC_FILE_KEY=change-this-to-a-strong-random-key

# ── Threat Intel ──────────────────────────────────────────────────────────────
# Optional API keys for real threat intel feeds.
# OTX_API_KEY=your-alienvault-otx-key
# VIRUSTOTAL_API_KEY=your-vt-key
